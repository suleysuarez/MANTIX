APP_ENV=development
DATABASE_URL=
CORS_ORIGINS=http://localhost:4200
BACKEND_PORT=8000
RATE_LIMIT_PER_MINUTE=120
LOG_LEVEL=INFO
# Clerk remains enabled for the web application.
CLERK_SECRET_KEY=
CLERK_PUBLISHABLE_KEY=pk_test_replace-with-publishable-key
CLERK_AUTHORIZED_PARTIES=http://localhost:4200
# Mobile-native authentication. Use a long random secret (at least 32 bytes).
MOBILE_JWT_SECRET=
MOBILE_ACCESS_TOKEN_MINUTES=480
# SMTP for the verification and recovery codes (development/demo only).
# Gmail: 2-step verification + a 16-character app password. See README.md.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USERNAME=tucuenta@gmail.com
SMTP_PASSWORD=contrasena-de-aplicacion-de-16-caracteres
SMTP_FROM=tucuenta@gmail.com
AUTH_VERIFICATION_EXPIRE_MINUTES=10
UPLOAD_DIR=uploads
MAX_UPLOAD_MB=10
SCHEDULER_ENABLED=true
REMINDER_INTERVAL_MINUTES=60
